{
  "name": "gogecord",
  "version": "2.0.1",
  "description": "Cliente de Discord simple, ultra ligero, rápido y sin dependencias externas. Diseñado específicamente para Bun y enfocado en slash commands.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bunx tsc --noEmit",
    "test": "bun test/index.ts",
    "dev": "bun --watch test/index.ts"
  },
  "dependencies": {
    "discord-api-types": "^0.38.53"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guillejabase/gogecord"
  }
}